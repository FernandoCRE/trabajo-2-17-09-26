#include <iostream>
using namespace std;



class mult3
{
public:
    bool operator()(int a)
    {
        return !(a % 3);
    }
};


template <class O>
class Util
{
public:

   
    void merge(int* ini, int* mid, int* fin)
    {
        int* p = ini;
        int* q = mid;

        while (p < q && q < fin)
        {
            if (*q < *p)
            {
                int aux = *q;

                int* r = q;

                // mueve derecha
                while (r > p)
                {
                    *r = *(r - 1);
                    --r;
                }

                *p = aux;

                ++p;
                ++q;
                ++mid;
            }
            else
            {
                ++p;
            }
        }
    }


    
    void split(int* ini, int* fin)
    {
        O condicion;

        int* p = ini;

        //elementos
        int cantidad = fin - ini;

        while (cantidad > 0)
        {
            // 
            if (condicion(*p))
            {
                ++p;
            }

            // final
            else
            {
                int aux = *p;

                int* q = p;

                // mov izq
                while (q < fin - 1)
                {
                    *q = *(q + 1);
                    ++q;
                }

                // elem al final
                *(fin - 1) = aux;
            }

            --cantidad;
        }
    }


    
    void mostrar(int* ini, int* fin)
    {
        int* p = ini;

        while (p < fin)
        {
            cout << *p << " ";
            ++p;
        }

        cout << endl;
    }
};


int main()
{
    int A[] = { 1, 2, 3, 44, 45, 8, 11, 25, 30, 60 };

    int* ini = A;
    int* mid = A + 5;
    int* fin = A + 10;

    Util<mult3> util;


    cout << "array inicial:" << endl;
    util.mostrar(ini, fin);


   
    util.merge(ini, mid, fin);

    cout << "\nordenado:" << endl;
    util.mostrar(ini, fin);


    
    util.split(ini, fin);

    cout << "\nmult de 3:" << endl;
    util.mostrar(ini, fin);


    return 0;
}
